# MQTT broker
TUYAPILOT_MQTT_HOST=mosquitto
TUYAPILOT_MQTT_PORT=1883
TUYAPILOT_MQTT_USERNAME=
TUYAPILOT_MQTT_PASSWORD=
TUYAPILOT_BASE_TOPIC=tuyapilot2mqtt

# Seconds between two reads of the gateway (15 to 3600)
TUYAPILOT_POLL_INTERVAL=60
TUYAPILOT_CHANNELS=lan

# LAN channel: address of the Tuya gateway, and the folder holding devices.json (local keys)
TUYAPILOT_LAN_HOST=
TUYAPILOT_LAN_VERSION=3.3
TUYAPILOT_KEYS_DIR=./keys

# Sharing channel (add "sharing" to TUYAPILOT_CHANNELS): user code of the Smart Life app.
# The QR code to scan is printed in the container's log.
TUYAPILOT_SHARING_USER_CODE=

# Developer channel (add "developer"): Tuya IoT platform project. Unavailable while empty.
TUYAPILOT_DEVELOPER_ACCESS_ID=
TUYAPILOT_DEVELOPER_ACCESS_SECRET=
TUYAPILOT_DEVELOPER_REGION=eu

# The single write of this version: the manual setpoint of one designated thermostat. Closed by default.
TUYAPILOT_WRITES_ENABLED=false
TUYAPILOT_WRITE_DEVICE=
